{
  "permissions": {
    "deny": [
      "Read(~/.ssh/id_*)",
      "Read(~/.aws/credentials)",
      "Read(~/.mlflow/credentials)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.config/ml-scaffold/deny-probe)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.mlflow/**)"
    ],
    "allow": [
{{parts claude-allow}}
    ]
  }
}
